{
  "name": "portra",
  "version": "0.5.1",
  "description": "Portra - secure multi-customer portal workspace",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder -w -m",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder -w --x64",
    "dist:mac": "npm run build && electron-builder -m"
  },
  "keywords": [],
  "author": "Portra",
  "license": "MIT",
  "build": {
    "appId": "com.dmivas.portra",
    "productName": "Portra",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "build/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Portra"
    },
    "dmg": {
      "sign": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DimaVasilenko-Intune",
        "repo": "Portra"
      }
    ]
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DimaVasilenko-Intune/Portra"
  }
}
