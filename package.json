{
  "name": "portra",
  "version": "0.7.0",
  "description": "Portra - secure multi-customer portal workspace",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "test": "node --test \"electron/**/*.test.js\" \"src/**/*.test.mjs\"",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/dataFormat.js && npm test",
    "build": "vite build",
    "dist": "npm run build && electron-builder -w -m",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder -w --x64",
    "dist:mac": "npm run build && electron-builder -m",
    "install:mac-local": "npm run build && electron-builder -m dir && node scripts/install-mac-local.mjs"
  },
  "keywords": [],
  "author": "Portra",
  "license": "MIT",
  "build": {
    "appId": "com.dmivas.portra",
    "productName": "Portra",
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.test.js",
      "package.json",
      "build/icon.*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "A portal page you opened requested camera access.",
        "NSMicrophoneUsageDescription": "A portal page you opened requested microphone access.",
        "NSBluetoothAlwaysUsageDescription": "Portra uses Bluetooth to reach a security key when you sign in to a portal."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Portra"
    },
    "dmg": {
      "sign": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DimaVasilenko-Intune",
        "repo": "Portra"
      }
    ]
  },
  "comment": "react/react-dom are build-time only — Vite bundles them into dist/. Keeping them out of dependencies stops electron-builder shipping a second unused copy inside the app.",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DimaVasilenko-Intune/Portra"
  }
}
